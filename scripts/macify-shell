#!/bin/bash
# macify-shell — compatibility wrapper; forwards to: macify [options] shell ...
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

V=""
PREFIX_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) V="-v"; shift ;;
        --prefix)     PREFIX_ARGS=(--prefix "$2"); shift 2 ;;
        *) break ;;
    esac
done

exec "$DIR/macify" $V "${PREFIX_ARGS[@]+"${PREFIX_ARGS[@]}"}" shell "$@"
